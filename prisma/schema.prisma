generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum Role {
  OWNER
  SALESMAN
}

enum PaymentType {
  SHOP_COLLECTION
  FACTORY_PAYMENT
}

enum PaymentMethod {
  BANK_TRANSFER
  CHEQUE
  CASH
}

enum DealType {
  VIA_SALESMAN
  DIRECT_OWNER
}

enum TransactionType {
  CREDIT 
  DEBIT
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
}

// --- MODELS ---

model Region {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  shops     Shop[]

  @@map("regions")
}

model Brand {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Predefined prices and unit details
  pricePerTon   Decimal? @db.Decimal(12, 2)
  pricePerBag   Decimal? @db.Decimal(12, 2)
  defaultUnit   String?  @default("BAGS") // "TONS" or "BAGS"

  inventoryIntakes  InventoryIntake[]
  distributions     Distribution[]
  inventoryBalances InventoryBalance[]
  inventoryLedgers  InventoryLedger[]
  payments          Payment[]

  @@map("brands")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryIntakes InventoryIntake[]
  distributions    Distribution[]
  payments         Payment[]

  @@map("users")
}

model Shop {
  id          String   @id @default(uuid())
  name        String
  regionId    String
  region      Region   @relation(fields: [regionId], references: [id])
  address     String?
  phoneNumber String?
  
  currentBalance Decimal @default(0.00) @db.Decimal(12, 2)

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  distributions Distribution[]
  payments      Payment[]
  ledgers       Ledger[] 

  @@map("shops")
}

model InventoryIntake {
  id            String   @id @default(uuid())
  brandId       String
  brand         Brand    @relation(fields: [brandId], references: [id])
  quantity      Int
  unitPrice     Decimal? @db.Decimal(12, 2)
  totalPrice    Decimal? @db.Decimal(12, 2)
  vehicleNumber String?
  intakeDate    DateTime @default(now())
  notes         String?

  // Recorded unit type
  quantityType  String   @default("BAGS") // "TONS" or "BAGS"

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inventory_intakes")
}

model Distribution {
  id               String   @id @default(uuid())
  brandId          String
  brand            Brand    @relation(fields: [brandId], references: [id])
  quantity         Int
  
  unitPrice        Decimal  @db.Decimal(12, 2) 
  totalAmount      Decimal  @db.Decimal(12, 2) 
  
  distributionDate DateTime @default(now())
  dealType         DealType @default(VIA_SALESMAN)
  notes            String?

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])

  ledger       Ledger?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("distributions")
}

model Payment {
  id            String        @id @default(uuid())
  type          PaymentType
  paymentMethod PaymentMethod @default(BANK_TRANSFER)
  amount        Decimal       @db.Decimal(12, 2)
  paymentDate   DateTime      @default(now())
  receiptUrl    String?
  cashNote      String?
  dealType      DealType      @default(VIA_SALESMAN)

  shopId String?
  shop   Shop?   @relation(fields: [shopId], references: [id])

  brandId String?
  brand   Brand?   @relation(fields: [brandId], references: [id])

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])

  ledger       Ledger?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

// LEDGER MODEl
model Ledger {
  id              String          @id @default(uuid())
  shopId          String
  shop            Shop            @relation(fields: [shopId], references: [id])
  
  transactionType TransactionType
  amount          Decimal         @db.Decimal(12, 2)
  description     String?         
  
  paymentId       String?         @unique
  payment         Payment?        @relation(fields: [paymentId], references: [id])
  
  distributionId  String?         @unique
  distribution    Distribution?   @relation(fields: [distributionId], references: [id])

  createdAt       DateTime        @default(now())

  @@map("ledgers")
}

model InventoryLedger {
  id              String                   @id @default(uuid())
  brandId         String
  brand           Brand                    @relation(fields: [brandId], references: [id])
  quantity        Int
  type            InventoryTransactionType
  date            DateTime                 @default(now())
  
  referenceId     String?                  // ID of the Intake or Distribution record
  description     String?
  totalPrice      Decimal?                 @db.Decimal(12, 2)

  // Recorded unit type
  quantityType    String?                  @default("BAGS") // "TONS" or "BAGS"

  createdAt       DateTime                 @default(now())

  @@map("inventory_ledgers")
}

model InventoryBalance {
  id               String   @id @default(uuid())
  brandId          String   @unique
  brand            Brand    @relation(fields: [brandId], references: [id])
  totalIntake      Int      @default(0)
  totalDistributed Int      @default(0)
  currentStock     Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@map("inventory_balance")
}
